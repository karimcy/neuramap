{
  "$defs": {
    "Aggregate": {
      "additionalProperties": false,
      "description": "A curated interval with a value. ``usable_ms + rejected_ms + gap_ms`` is the period.",
      "properties": {
        "gap_ms": {
          "minimum": 0,
          "title": "Gap Ms",
          "type": "integer"
        },
        "kind": {
          "const": "aggregate",
          "title": "Kind",
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/ValueQuality"
        },
        "rejected_ms": {
          "minimum": 0,
          "title": "Rejected Ms",
          "type": "integer"
        },
        "slot": {
          "minimum": 0,
          "title": "Slot",
          "type": "integer"
        },
        "usable_ms": {
          "minimum": 0,
          "title": "Usable Ms",
          "type": "integer"
        },
        "value": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "slot",
        "value",
        "quality",
        "usable_ms",
        "rejected_ms",
        "gap_ms"
      ],
      "title": "Aggregate",
      "type": "object"
    },
    "CuratedGap": {
      "additionalProperties": false,
      "description": "A curated interval without a value: too little usable time. ``reason`` is the single raw\nreason when the whole interval was one gap, else ``insufficient_coverage``.",
      "properties": {
        "gap_ms": {
          "minimum": 0,
          "title": "Gap Ms",
          "type": "integer"
        },
        "kind": {
          "const": "gap",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/GapReason"
        },
        "rejected_ms": {
          "minimum": 0,
          "title": "Rejected Ms",
          "type": "integer"
        },
        "slot": {
          "minimum": 0,
          "title": "Slot",
          "type": "integer"
        },
        "usable_ms": {
          "minimum": 0,
          "title": "Usable Ms",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "slot",
        "reason",
        "usable_ms",
        "rejected_ms",
        "gap_ms"
      ],
      "title": "CuratedGap",
      "type": "object"
    },
    "CurationMethod": {
      "additionalProperties": false,
      "description": "How raw becomes one curated interval, stated in full (so the record recomputes from IC-14\nalone). ``method_id`` names the method across revisions; a changed method under the same id\nis a ``method_change``. Every number is required: no published source sets a threshold.",
      "properties": {
        "aggregation": {
          "enum": [
            "mean",
            "min",
            "max",
            "last"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "applied_findings": {
          "items": {
            "$ref": "#/$defs/FindingKind"
          },
          "title": "Applied Findings",
          "type": "array"
        },
        "kind": {
          "const": "curation_method",
          "title": "Kind",
          "type": "string"
        },
        "method_id": {
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Method Id",
          "type": "string"
        },
        "min_usable_ms": {
          "minimum": 1,
          "title": "Min Usable Ms",
          "type": "integer"
        },
        "rounding": {
          "anyOf": [
            {
              "enum": [
                "floor",
                "ceil",
                "half_even"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/NotApplicable"
            }
          ],
          "title": "Rounding"
        },
        "usable": {
          "items": {
            "$ref": "#/$defs/ValueQuality"
          },
          "minItems": 1,
          "title": "Usable",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "method_id",
        "aggregation",
        "min_usable_ms",
        "usable",
        "applied_findings",
        "rounding"
      ],
      "title": "CurationMethod",
      "type": "object"
    },
    "FindingKind": {
      "description": "What a data-quality monitor found (WP-TEL-03).",
      "enum": [
        "gap",
        "flatline",
        "clock_drift",
        "unit_mismatch",
        "meter_scada_divergence"
      ],
      "title": "FindingKind",
      "type": "string"
    },
    "GapReason": {
      "description": "Why there is no value. Every member is an OPC UA Bad status.",
      "enum": [
        "comms_lost",
        "sensor_failure",
        "device_failure",
        "out_of_service",
        "configuration_error",
        "clock_untrusted",
        "buffer_lost",
        "not_recorded",
        "insufficient_coverage"
      ],
      "title": "GapReason",
      "type": "string"
    },
    "NotApplicable": {
      "additionalProperties": false,
      "description": "A term that does not exist for this record (e.g. a LIFO position on a firm connection).\n\nDistinct from `Unknown`: \"not applicable\" is a statement about the agreement, \"unknown\" is a\nstatement about our knowledge of it. Both carry a reason.",
      "properties": {
        "kind": {
          "const": "not_applicable",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "title": "NotApplicable",
      "type": "object"
    },
    "RawSpan": {
      "additionalProperties": false,
      "description": "A contiguous run of one raw chain, committed by its first prev hash and its head hash.",
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "first_prev_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "First Prev Hash",
          "type": "string"
        },
        "first_seq": {
          "minimum": 0,
          "title": "First Seq",
          "type": "integer"
        },
        "kind": {
          "const": "raw_span",
          "title": "Kind",
          "type": "string"
        },
        "last_batch_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Last Batch Hash",
          "type": "string"
        },
        "last_seq": {
          "minimum": 0,
          "title": "Last Seq",
          "type": "integer"
        },
        "sender_id": {
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Sender Id",
          "type": "string"
        },
        "series_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Series Id",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "stream_epoch": {
          "minimum": 0,
          "title": "Stream Epoch",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "series_id",
        "sender_id",
        "stream_epoch",
        "first_seq",
        "last_seq",
        "first_prev_hash",
        "last_batch_hash",
        "start",
        "end"
      ],
      "title": "RawSpan",
      "type": "object"
    },
    "TenantKey": {
      "additionalProperties": false,
      "description": "The data owner (an IC-13 organisation) and the site. Lender and verifier organisations\nnever own telemetry; they read it through IC-13 scopes.",
      "properties": {
        "kind": {
          "const": "tenant_key",
          "title": "Kind",
          "type": "string"
        },
        "org_id": {
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]*$",
          "title": "Org Id",
          "type": "string"
        },
        "org_kind": {
          "enum": [
            "customer",
            "neura"
          ],
          "title": "Org Kind",
          "type": "string"
        },
        "site_id": {
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]*$",
          "title": "Site Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "org_id",
        "org_kind",
        "site_id"
      ],
      "title": "TenantKey",
      "type": "object"
    },
    "ValueQuality": {
      "description": "The quality of a value. Declaration order is the worst-of order, best first.",
      "enum": [
        "good",
        "local_override",
        "inaccurate",
        "out_of_range",
        "subnormal",
        "held"
      ],
      "title": "ValueQuality",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "IC-14 v1.0.0: one block of a series at a curated resolution, computed from raw only by\n`curate`, and recomputable by `verify_curated`. Identified by (series, origin, resolution,\nmethod id); a later revision supersedes the earlier one by hash.",
  "properties": {
    "annotations": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Annotations",
      "type": "array"
    },
    "contract": {
      "const": "IC-14",
      "default": "IC-14",
      "title": "Contract",
      "type": "string"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "data_class": {
      "enum": [
        "neura_operational",
        "customer_commercial",
        "customer_personal"
      ],
      "title": "Data Class",
      "type": "string"
    },
    "descriptor_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Descriptor Hash",
      "type": "string"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/RawSpan"
      },
      "title": "Inputs",
      "type": "array"
    },
    "intervals": {
      "items": {
        "discriminator": {
          "mapping": {
            "aggregate": "#/$defs/Aggregate",
            "gap": "#/$defs/CuratedGap"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/Aggregate"
          },
          {
            "$ref": "#/$defs/CuratedGap"
          }
        ]
      },
      "minItems": 1,
      "title": "Intervals",
      "type": "array"
    },
    "kind": {
      "const": "curated_series",
      "title": "Kind",
      "type": "string"
    },
    "method": {
      "$ref": "#/$defs/CurationMethod"
    },
    "origin": {
      "format": "date-time",
      "title": "Origin",
      "type": "string"
    },
    "record_class": {
      "enum": [
        "live",
        "synthetic_fixture"
      ],
      "title": "Record Class",
      "type": "string"
    },
    "resolution": {
      "enum": [
        "operational_1s",
        "standard_1min",
        "settlement_30min"
      ],
      "title": "Resolution",
      "type": "string"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "series_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Series Id",
      "type": "string"
    },
    "site_id": {
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]*$",
      "title": "Site Id",
      "type": "string"
    },
    "source_resolution": {
      "enum": [
        "event_20hz",
        "operational_1s",
        "standard_1min"
      ],
      "title": "Source Resolution",
      "type": "string"
    },
    "supersede_reason": {
      "anyOf": [
        {
          "enum": [
            "late_raw",
            "annotation_change",
            "method_change"
          ],
          "type": "string"
        },
        {
          "$ref": "#/$defs/NotApplicable"
        }
      ],
      "title": "Supersede Reason"
    },
    "supersedes": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "$ref": "#/$defs/NotApplicable"
        }
      ],
      "title": "Supersedes"
    },
    "tenant": {
      "$ref": "#/$defs/TenantKey"
    }
  },
  "required": [
    "tenant",
    "site_id",
    "series_id",
    "data_class",
    "record_class",
    "kind",
    "descriptor_hash",
    "origin",
    "resolution",
    "source_resolution",
    "method",
    "inputs",
    "annotations",
    "intervals",
    "revision",
    "supersedes",
    "supersede_reason"
  ],
  "title": "CuratedSeries",
  "type": "object"
}

{
  "$defs": {
    "ConnectionAgreementRef": {
      "additionalProperties": false,
      "description": "The IC-1 agreement the restrictions apply under, by content hash.",
      "properties": {
        "agreement_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Agreement Hash",
          "type": "string"
        },
        "contract": {
          "const": "IC-1",
          "title": "Contract",
          "type": "string"
        },
        "contract_version": {
          "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Contract Version",
          "type": "string"
        },
        "kind": {
          "const": "connection_agreement_ref",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "contract",
        "contract_version",
        "agreement_hash"
      ],
      "title": "ConnectionAgreementRef",
      "type": "object"
    },
    "LatencyBudget": {
      "additionalProperties": false,
      "description": "At least ``quantile_per_mille``/1000 of a path's deliveries take at most ``bound_ms``,\njudged over at least ``min_samples`` deliveries (nearest-rank quantile, `check_latency`).\n\nThe path set has no ANM member: the ANM path never crosses the cloud link.",
      "properties": {
        "bound_ms": {
          "minimum": 1,
          "title": "Bound Ms",
          "type": "integer"
        },
        "kind": {
          "const": "latency_budget",
          "title": "Kind",
          "type": "string"
        },
        "min_samples": {
          "minimum": 1,
          "title": "Min Samples",
          "type": "integer"
        },
        "path": {
          "enum": [
            "cloud_to_edge_schedule",
            "edge_to_cloud_ack",
            "heartbeat"
          ],
          "title": "Path",
          "type": "string"
        },
        "quantile_per_mille": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Quantile Per Mille",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "path",
        "quantile_per_mille",
        "bound_ms",
        "min_samples"
      ],
      "title": "LatencyBudget",
      "type": "object"
    },
    "LatencyBudgets": {
      "additionalProperties": false,
      "properties": {
        "cloud_to_edge_schedule": {
          "$ref": "#/$defs/LatencyBudget"
        },
        "edge_to_cloud_ack": {
          "discriminator": {
            "mapping": {
              "latency_budget": "#/$defs/LatencyBudget",
              "not_applicable": "#/$defs/NotApplicable"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/LatencyBudget"
            },
            {
              "$ref": "#/$defs/NotApplicable"
            }
          ],
          "title": "Edge To Cloud Ack"
        },
        "heartbeat": {
          "discriminator": {
            "mapping": {
              "latency_budget": "#/$defs/LatencyBudget",
              "not_applicable": "#/$defs/NotApplicable"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/LatencyBudget"
            },
            {
              "$ref": "#/$defs/NotApplicable"
            }
          ],
          "title": "Heartbeat"
        }
      },
      "required": [
        "cloud_to_edge_schedule",
        "edge_to_cloud_ack",
        "heartbeat"
      ],
      "title": "LatencyBudgets",
      "type": "object"
    },
    "NotApplicable": {
      "additionalProperties": false,
      "description": "A term that does not exist for this record (e.g. a LIFO position on a firm connection).\n\nDistinct from `Unknown`: \"not applicable\" is a statement about the agreement, \"unknown\" is a\nstatement about our knowledge of it. Both carry a reason.",
      "properties": {
        "kind": {
          "const": "not_applicable",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "title": "NotApplicable",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "IC-5 v1.0.0: one site's link parameters. Bound by hash: every frame names it\n(``profile_hash``) and both ends refuse a frame sent under another profile.\n\nEvery number is required with no default (no published source sets them). Equality at a\nthreshold resolves to fail-safe (`link_state`).",
  "properties": {
    "anm_authority": {
      "const": "edge_local",
      "title": "Anm Authority",
      "type": "string"
    },
    "cloud_heartbeat_interval_ms": {
      "minimum": 1,
      "title": "Cloud Heartbeat Interval Ms",
      "type": "integer"
    },
    "connection_agreement": {
      "$ref": "#/$defs/ConnectionAgreementRef"
    },
    "contract": {
      "const": "IC-5",
      "default": "IC-5",
      "title": "Contract",
      "type": "string"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "control_lease_ms": {
      "minimum": 1,
      "title": "Control Lease Ms",
      "type": "integer"
    },
    "edge_heartbeat_interval_ms": {
      "minimum": 1,
      "title": "Edge Heartbeat Interval Ms",
      "type": "integer"
    },
    "edge_silent_after_ms": {
      "minimum": 1,
      "title": "Edge Silent After Ms",
      "type": "integer"
    },
    "kind": {
      "const": "link_profile",
      "title": "Kind",
      "type": "string"
    },
    "latency_budgets": {
      "$ref": "#/$defs/LatencyBudgets"
    },
    "max_clock_skew_ms": {
      "minimum": 0,
      "title": "Max Clock Skew Ms",
      "type": "integer"
    },
    "max_frame_bytes": {
      "minimum": 1,
      "title": "Max Frame Bytes",
      "type": "integer"
    },
    "mpc_cadence_ms": {
      "minimum": 1,
      "title": "Mpc Cadence Ms",
      "type": "integer"
    },
    "profile_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Profile Id",
      "type": "string"
    },
    "record_class": {
      "enum": [
        "live",
        "synthetic_fixture"
      ],
      "title": "Record Class",
      "type": "string"
    },
    "resume_hold_ms": {
      "minimum": 0,
      "title": "Resume Hold Ms",
      "type": "integer"
    },
    "schedule_max_age_ms": {
      "minimum": 1,
      "title": "Schedule Max Age Ms",
      "type": "integer"
    },
    "schedule_required_lookahead_ms": {
      "minimum": 1,
      "title": "Schedule Required Lookahead Ms",
      "type": "integer"
    },
    "site_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Site Id",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "profile_id",
    "site_id",
    "record_class",
    "connection_agreement",
    "anm_authority",
    "cloud_heartbeat_interval_ms",
    "edge_heartbeat_interval_ms",
    "control_lease_ms",
    "schedule_max_age_ms",
    "schedule_required_lookahead_ms",
    "mpc_cadence_ms",
    "edge_silent_after_ms",
    "resume_hold_ms",
    "max_clock_skew_ms",
    "max_frame_bytes",
    "latency_budgets"
  ],
  "title": "LinkProfile",
  "type": "object"
}
